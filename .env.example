# OpenAI: chat model (agent.py) + embeddings (vector_store.py, qdrant_store.py)
OPENAI_API_KEY=

# Qdrant: persona vector store (call_notes, complaints) - see docker-compose.yml
QDRANT_URL=http://localhost:6333

# LangSmith: optional tracing for agent.py / agent_graph.py runs (tool calls, every
# OpenAI request/response, compliance verdicts). Leave LANGSMITH_TRACING unset/false
# to run with no tracing overhead and no LangSmith account required.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wealth-management-copilot
